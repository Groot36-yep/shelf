{
  "name": "shelf",
  "productName": "Shelf",
  "version": "2.0.0",
  "description": "Rename your movie and TV files so Plex recognizes them. Private by design.",
  "author": "Groot36-yep",
  "license": "MIT",
  "homepage": "https://groot36-yep.github.io/shelf/",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tests/parser.test.js && node tests/remember.test.js && node tests/fileops.test.js && node tests/subs.test.js && node tests/cards-real.test.js && node tests/scan.test.js && node tests/updates.test.js && node tests/ssh-loopback.test.js && node tests/server.test.js && node tests/plexsend.test.js && node tests/plexfix.test.js && node tests/hwaccel.test.js",
    "dist:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "io.github.groot36-yep.shelf",
    "productName": "Shelf",
    "copyright": "Copyright © 2026 Groot36-yep",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "app/**",
      "desktop/**",
      "package.json",
      "!**/*.map",
      "!node_modules/@tesseract.js-data/eng/4.0.0_best_int/**",
      "!node_modules/ffmpeg-static/*.md",
      "!node_modules/ffmpeg-static/example.js",
      "!**/tesseract.js-core/*.wasm.js",
      "!**/tesseract.js-core/*-lstm.{js,wasm}",
      "!**/tesseract.js/{dist,docs,examples,scripts}/**",
      "!**/node_modules/**/{README,CHANGELOG,HISTORY}*.md",
      "!node_modules/cpu-features/**",
      "!node_modules/nan/**",
      "!node_modules/ssh2/lib/protocol/crypto/build/**",
      "!node_modules/ssh2/lib/protocol/crypto/src/**",
      "!node_modules/ssh2/install.js",
      "!node_modules/ssh2/examples/**",
      "!node_modules/ssh2/test/**",
      "!node_modules/tweetnacl/{nacl.js,nacl.min.js,nacl-fast.min.js}"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shelf",
      "artifactName": "Shelf-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Shelf-Portable-${version}.exe",
      "splashImage": "build/splash.bmp"
    },
    "publish": null,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@tesseract.js-data/**",
      "node_modules/tesseract.js/**",
      "node_modules/bmp-js/**",
      "node_modules/idb-keyval/**",
      "node_modules/is-url/**",
      "node_modules/node-fetch/**",
      "node_modules/whatwg-url/**",
      "node_modules/tr46/**",
      "node_modules/webidl-conversions/**",
      "node_modules/regenerator-runtime/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/wasm-feature-detect/**",
      "node_modules/zlibjs/**"
    ],
    "npmRebuild": false
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "ffmpeg-static": "5.3.0",
    "ssh2": "1.17.0",
    "tesseract.js": "7.0.0"
  }
}
