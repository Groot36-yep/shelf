{
  "name": "shelf",
  "productName": "Shelf",
  "version": "1.0.0",
  "description": "Rename your movie and TV files so Plex recognizes them. Private by design.",
  "author": "Groot36-yep",
  "license": "MIT",
  "homepage": "https://groot36-yep.github.io/shelf/",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tests/parser.test.js && node tests/scripts.test.js && node tests/fileops.test.js",
    "dist:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "io.github.groot36-yep.shelf",
    "productName": "Shelf",
    "copyright": "Copyright © 2026 Groot36-yep",
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "assets/**",
      "desktop/**",
      "package.json",
      "!**/*.map"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shelf",
      "artifactName": "Shelf-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Shelf-Portable-${version}.exe"
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
